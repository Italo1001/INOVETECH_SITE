# Copie para .env.local (local) ou cadastre na Vercel em Settings → Environment Variables.
# Nenhum destes dados é secreto: todos aparecem publicamente no site.

# Domínio definitivo, com https e sem barra final (ex.: https://www.seudominio.com.br)
NEXT_PUBLIC_SITE_URL=

# WhatsApp comercial: apenas dígitos, com DDI 55 + DDD (ex.: 5521999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Mensagem pré-preenchida (opcional)
NEXT_PUBLIC_WHATSAPP_MESSAGE=

# E-mail comercial
NEXT_PUBLIC_CONTACT_EMAIL=

# Redes sociais (somente URLs https)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
